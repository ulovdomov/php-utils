{
  "name": "ulovdomov/utils",
  "description": "Php Utils Package",
  "license": "MIT",
  "require": {
    "php": ">=8.1 <8.5"
  },
  "require-dev": {
    "ulovdomov/php-code-style": "v25.03.27.1",
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11",
    "phpstan/phpstan-strict-rules": "^1.6"
  },
  "scripts": {
    "install": "composer install --no-interaction --no-progress --prefer-dist",
    "cs": "mkdir -p temp/.php-codesniffer-cache && phpcs --standard=tools/phpcs.xml src tests",
    "cs-fix": "mkdir -p temp/.php-codesniffer-cache && phpcbf --standard=tools/phpcs.xml src tests",
    "phpstan": "mkdir -p temp/.php-stan-cache && phpstan analyse -c tools/phpstan.neon --memory-limit=1024M",
    "tests": "phpunit tests --configuration tests/phpunit.xml"
  },
  "autoload": {
    "psr-4": {
      "UlovDomov\\": "src\\Utils"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/Tests"
    }
  },
  "archive": {
    "exclude": [
      ".github/",
      ".infrastructure/",
      "tests/",
      "tools/",
      ".env.template",
      ".gitignore",
      "docker-compose.yml",
      "Makefile"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/ulovdomov/php-code-style"
    }
  ]
}
